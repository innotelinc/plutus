#!/bin/sh
# Pre-commit hook for plutus
# Runs basic checks before allowing a commit.

set -e

echo "Running pre-commit checks..."

# Check for accidentally committed secrets
if git diff --cached --name-only | grep -qE '\.env$|\.env\.local$|\.pem$|credentials'; then
    echo "ERROR: Attempting to commit sensitive files"
    echo "Staged files:"
    git diff --cached --name-only
    exit 1
fi

# Check for console.log left in source files
if git diff --cached --name-only | grep -E '\.tsx?$' | while read f; do
    git show ":$f" | grep -n 'console\.log' | grep -v '// console.log'
done | grep -q .; then
    echo "WARNING: console.log found in staged changes"
fi

echo "Pre-commit checks passed"
