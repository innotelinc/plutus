# ─── Innotel platform services (shared layers) ─────────────────────────
# PLUTUS consumes the platform services instead of re-implementing them:
#   Cerulean (TrustOps)   — DNS + wildcard TLS for plutus.innotel.us
#   NPM Edge (EdgeOps)    — public routing for the plutus.innotel.us hosts
#   Infisical (SecretOps) — production secrets live in Infisical; this file is
#                           a derived, local-only template and is gitignored.
# Cerulean DNS API (canonical example value):
# CERULEAN_DNS_API_URL='http://127.0.0.1:3003'

# ─── Convex self-hosted (docker compose) ────────────────────────────────
# See https://github.com/get-convex/convex-backend/blob/main/self-hosted/README.md
# Used by the Convex CLI (push / dev / run). Generate the admin key with:
#   docker compose exec backend ./generate_admin_key.sh
#
# Host address: set PLUTUS_HOST to this machine's LAN IP so other devices on
# the network can reach the stack. `node scripts/lan-ip.mjs` prints the
# autodetected address. Leave empty for localhost-only access.
PLUTUS_HOST=''
CONVEX_SELF_HOSTED_URL='http://127.0.0.1:3210'
CONVEX_SELF_HOSTED_ADMIN_KEY='<your admin key>'

# Used by the browser + Next.js build to reach the backend.
NEXT_PUBLIC_CONVEX_URL='http://127.0.0.1:3210'

# Site proxy (HTTP actions / file serving) — must be reachable from the browser.
NEXT_PUBLIC_CONVEX_SITE_URL='http://127.0.0.1:3211'

# Protects clearMockData (see convex/channel.ts). Change in production.
ADMIN_SECRET='plutus-admin-secret-change-in-production'

# ─── Image generation for video keyframes (OmniRoute) ────────────────────
# The pipeline generates 3 keyframes per clip via an image model through
# OmniRoute, then animates them with ffmpeg minterpolate. Set to a specific
# model for deterministic results, e.g. "stabilityai/stable-diffusion-xl-base-1.0".
# "auto" lets OmniRoute pick its best connected image provider.
OMNIROUTE_IMAGE_MODEL='auto'

# ─── Product scripting — OpenClaw/OpenClaude via OmniRoute ─────────────
# OmniRoute is the OpenAI-compatible gateway the PLUTUS pipeline posts
# scripts (and image generation requests) to. PLUTUS uses the shared
# platform instance (zeus) — it is not part of the compose stack. OpenClaude
# (CLI) and OpenClaw (assistant gateway) point at this same URL.
OMNIROUTE_BASE_URL='http://127.0.0.1:20128/v1'
# Optional key if your OmniRoute instance requires one
# OMNIROUTE_API_KEY=''
# Scripting model — pinned for deterministic scripts, "auto" for best.
OMNIROUTE_MODEL='auto'
# Image model for video keyframes — pinned for deterministic visuals, "auto" for best.
OMNIROUTE_IMAGE_MODEL='auto'

# ─── SSO — Cerulean Authentik (OIDC) ─────────────────────────────────────
# PLUTUS authenticates viewers through the shared platform identity plane
# (Cerulean Authentik). Provision the OIDC client with:
#   python3 scripts/provision-authentik.py
# which writes AUTHENTIK_CLIENT_ID / AUTHENTIK_CLIENT_SECRET into .env.local.
# All of these are set on the backend with `npx convex env set` (the HTTP
# actions read them from process.env):
#   AUTHENTIK_ISSUER      e.g. http://192.168.1.46:9000 (default http://127.0.0.1:9000)
#   AUTHENTIK_APP_SLUG    e.g. plutus (default plutus)
#   AUTHENTIK_ADMIN_GROUP e.g. plutus-admins (default plutus-admins)
#   AUTHENTIK_CLIENT_ID / AUTHENTIK_CLIENT_SECRET  (from the provision script)
#   SESSION_SECRET        HMAC key for the session cookie (required)
#   PUBLIC_URL            e.g. http://192.168.1.46:3000 (default http://127.0.0.1:3000)
# Public URL is also needed by the provision script (redirect_uri must match
# the app origin exactly). Set it in .env.local:
PUBLIC_URL='http://127.0.0.1:3000'
